    "class Point:\n",
    "\tdef __init__(self, x=0, y=0):\n",
    "\t\tself.x = x\n",
    "\t\tself.y = y\n",
    "\n",
    "\tdef __str__(self):\n",
    "\t\treturn f\"({self.x}, {self.y})\"\n",
    "\n",
    "\tdef __add__(self, other):\n",
    "\t\treturn Point(self.x + other.x, self.y + other.y)\n",
    "\n",
    "p = Point(1, 2)\n",
    "q = Point(3, 4)\n",
